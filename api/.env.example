# Ruta del modelo Keras. Si el archivo no existe, la API funciona en modo demostración.
MODEL_PATH=models/mandidog_v1.keras

# Umbrales de riesgo (probabilidad de la clase "con signos")
UMBRAL_AMARILLO=0.30
UMBRAL_ROJO=0.60

# Tamaño máximo de la imagen en MB
MAX_TAMANO_MB=10

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=*
